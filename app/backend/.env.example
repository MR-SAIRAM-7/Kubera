# Backend CORS settings
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# Dashboard cache and streaming
DASHBOARD_CACHE_TTL_SECONDS=45
DASHBOARD_CACHE_MAX_ITEMS=256
WS_STREAM_INTERVAL_SECONDS=5

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Optional MongoDB persistence for /api/status routes
MONGO_URL=
DB_NAME=

# Optional alert integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional future LLM/vector integrations
OPENAI_API_KEY=
PINECONE_API_KEY=

# Market AI safety controls
KUBERA_MODE=advisory
LIVE_TRADING_ENABLED=false
HUMAN_APPROVAL_REQUIRED=true
KILL_SWITCH_ENABLED=true
